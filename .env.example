# LLM provider: gemini | groq | ollama | offline  (used from Phase 2)
LLM_PROVIDER=offline
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3

# SQLite database path (defaults to data/hospital_discharge_cases.sqlite)
DB_PATH=data/hospital_discharge_cases.sqlite

# Max seconds to wait on any department subsystem before marking it TIMEOUT
SUBSYSTEM_TIMEOUT_S=2.5
